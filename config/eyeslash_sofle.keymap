#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 35    // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    zip_scroll_scaler: zip_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <0>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <30>;
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        Caps {
            bindings = <&kp CAPS>;
            key-positions = <39 13>;
        };

        I_love_big_black_cocks {
            bindings = <&mo 5>;
            key-positions = <40 17>;
            layers = <0>;
        };

        fourth_one {
            bindings = <&mo 4>;
            key-positions = <53 63>;
        };
    };

    macros {
        pass1: pass1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q>;
            label = "PASS1";
        };

        pass2: pass2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q>;
            label = "PASS2";
        };

        pass3: pass3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q>;
            label = "PASS3";
        };

        pass4: pass4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q>;
            label = "PASS4";
        };

        pass5: pass5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q>;
            label = "PASS5";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        SEX_0 {
            bindings = <
&kp ESC     &kp N1     &kp N2        &kp N3        &kp N4  &kp N5       &kp UP_ARROW     &kp N6      &kp N7  &kp N8      &kp N9         &kp N0             &kp BACKSPACE
&kp TAB     &kp Q      &kp W         &kp E         &kp R   &kp T        &kp DOWN_ARROW   &kp Y       &kp U   &kp I       &kp O          &kp P              &kp BSLH
&kp TILDE   &kp A      &kp S         &kp D         &kp F   &kp G        &kp LEFT_ARROW   &kp H       &kp J   &kp K       &kp L          &kp SEMI           &kp APOS
&kp LSHFT   &kp Z      &kp X         &kp C         &kp V   &kp B        &kp RIGHT_ARROW  &kp N       &kp M   &kp COMMA   &kp DOT        &kp FSLH           &kp RIGHT_SHIFT
&kp C_MUTE  &kp LCTRL  &kp LEFT_GUI  &kp LEFT_ALT  &mo 1   &kp SPACE    &kp ENTER        &kp RETURN  &mo 2   &kp DELETE  &kp RIGHT_GUI  &kp RIGHT_CONTROL
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "SEX_0";
        };

        SEX_1 {
            bindings = <
&trans      &kp F1                 &kp F2               &kp F3             &kp F4           &kp F5                   &mmv MOVE_UP     &kp F6          &kp F7         &kp F8        &kp F9     &kp F10           &trans
&trans      &kp C_AL_FILE_BROWSER  &kp LA(K_SCROLL_UP)  &kp K_SCROLL_DOWN  &kp K_SCROLL_UP  &kp LA(K_SCROLL_DOWN)    &mmv MOVE_DOWN   &kp HOME        &kp PAGE_DOWN  &kp PAGE_UP   &kp END    &kp MINUS         &kp EQUAL
&kp GRAVE   &kp C_AL_WWW           &mkp MB1             &mkp MB3           &mkp MB2         &mkp MB5                 &mmv MOVE_LEFT   &kp LEFT_ARROW  &kp DOWN       &kp UP_ARROW  &kp RIGHT  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&trans      &kp C_AL_TEXT_EDITOR   &kp C_PREV           &kp C_PLAY_PAUSE   &kp C_NEXT       &kp K_CALCULATOR         &mmv MOVE_RIGHT  &kp F11         &kp F12        &kp INS       &none      &none             &trans
&kp C_MUTE  &trans                 &trans               &trans             &trans           &trans                   &mkp LCLK        &trans          &trans         &trans        &trans     &trans
            >;

            display-name = "SEX_1";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        SEX_2 {
            bindings = <
&trans  &none       &none   &none        &none   &none     &mmv MOVE_UP     &none   &none   &kp FSLH  &kp STAR  &kp MINUS  &trans
&trans  &none       &none   &none        &none   &none     &mmv MOVE_DOWN   &none   &kp N7  &kp N8    &kp N9    &kp PLUS   &none
&trans  &none       &none   &none        &none   &none     &mmv MOVE_LEFT   &none   &kp N4  &kp N5    &kp N6    &kp N0     &none
&trans  &sys_reset  &none   &bootloader  &none   &none     &mmv MOVE_RIGHT  &none   &kp N1  &kp N2    &kp N3    &none      &trans
&none   &trans      &trans  &trans       &trans  &trans    &mkp LCLK        &trans  &trans  &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };

        SEX_3 {
            bindings = <
&none  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR    &none  &none            &none            &none           &none            &rgb_ug RGB_HUD  &rgb_ug RGB_HUI
&none  &none         &none         &none         &none         &none         &none  &none            &none            &none           &none            &rgb_ug RGB_SAD  &rgb_ug RGB_SAI
&none  &none         &bt BT_PRV    &out OUT_TOG  &bt BT_NXT    &none         &none  &rgb_ug RGB_EFR  &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &rgb_ug RGB_EFF  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI
&none  &none         &none         &none         &none         &none         &none  &none            &none            &none           &none            &rgb_ug RGB_SPD  &rgb_ug RGB_SPI
&none  &none         &none         &none         &none         &none         &none  &none            &none            &none           &none            &none
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        SEX_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        SEX_5 {
            bindings = <
&trans  &pass1  &pass2  &pass3  &pass4  &pass5    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Third_one {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
